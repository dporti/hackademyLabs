# Supabase — copia este fichero a .env.local y rellena con los valores de tu proyecto.
# Panel Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-publishable-key

# Solo servidor (service role). NUNCA exponer al cliente ni commitear el valor real.
# Se usa para operaciones privilegiadas: insertar en el ledger de créditos, seeds, admin.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio (respaldo para los enlaces de los emails de auth si la
# petición no trae cabecera Origin). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de contacto público (atención a familias). Si se deja vacío, no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=
